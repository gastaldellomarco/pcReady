SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional: shown in the sidebar after the app version (e.g. Cloud for SaaS).
# Leave empty or unset for on-prem / self-hosted builds with no deployment suffix.
VITE_DEPLOYMENT_LABEL=
# Maintenance UI (root route).
#
# Client-side (build-time) variables prefixed with `VITE_` are embedded into
# the client bundle during `vite build`. Changing them requires rebuilding
# and re-deploying the client bundle so browsers receive the new values.
# Use the following to enable the maintenance UI and optionally show an end time:
VITE_MAINTENANCE_MODE=false # true to show maintenance page in the client bundle
VITE_MAINTENANCE_END=2026-05-14T12:00:00Z # ISO 8601 with timezone (see examples below)
#
# ISO 8601 examples (required format for VITE_MAINTENANCE_END):
#  - Correct: 2025-12-31T23:59:00+01:00
#  - Correct: 2025-12-31T22:59:00Z
#  - Incorrect: 31/12/2025
#  - Incorrect: 2025-12-31 (no time/timezone)
#
# Runtime/server-side variables (optional)
# If you prefer toggling maintenance without rebuilding the client, set
# runtime variables in the server process or worker environment (no `VITE_` prefix):
# MAINTENANCE_MODE=true
# MAINTENANCE_END=2026-05-14T12:00:00Z
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tua-email@gmail.com
SMTP_PASS=tua-app-password
SMTP_FROM="PCReady <noreply@tuodominio.it>"
# Optional: distributed rate limiting across multiple instances (Upstash Redis).
# When unset, the app uses an in-memory sliding window limiter (single Node process).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=