SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional: webhook endpoint to receive test-email payloads from the app.
# When `EMAIL_TEST_WEBHOOK_URL` is set, `sendTestEmail` will POST a JSON body
# { to, subject, html, text, eventType } to this URL. Example serverless
# implementations are provided under `examples/` in the repo.
#
# Example (point this to a serverless function or external webhook):
# EMAIL_TEST_WEBHOOK_URL=https://your-deployment.com/api/send-email
#
# You can also use provider APIs directly (SendGrid example) inside the
# webhook. Provide provider credentials below if you plan to use SendGrid.
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM=no-reply@your-domain.com
#
# Examples shipped with this repo:
# - Vercel: examples/vercel-send-email/api/send-email.ts
# - Supabase Edge Function: examples/supabase-send-email/functions/send-email/index.ts

# Example values (uncomment and adapt for local testing):
# EMAIL_TEST_WEBHOOK_URL=https://mia-app.com/api/send-email
# (opzionale) fallback legacy
# SMTP_WEBHOOK_URL=https://mia-app.com/api/send-email

# Resend (https://resend.com) configuration (optional)
# Set your Resend API key to send emails directly via Resend.
# Example:
# RESEND_API_KEY=mr_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Sender address used for Resend API requests (from header)
# RESEND_FROM=no-reply@your-domain.com
#
# NOTE: the sending domain must be verified in Resend (https://resend.com/domains).
# Using free public mailbox domains like gmail.com will be rejected by Resend.
# To send from Resend, add your domain to Resend and verify the DNS records,
# or set `RESEND_FROM` to an already-verified domain.