SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional: shown in the sidebar after the app version (e.g. Cloud for SaaS).
# Leave empty or unset for on-prem / self-hosted builds with no deployment suffix.
VITE_DEPLOYMENT_LABEL=
# Maintenance UI (root route). Values are strings at build time: use true/false without quotes is fine.
# Restart the Vite dev server after changing these so the client bundle picks up new values.
# In preview/production, values are baked at `vite build` time unless you also set MAINTENANCE_* on the server process.
VITE_MAINTENANCE_MODE=false
# Optional ISO 8601 end time shown on the maintenance page (e.g. after deploy window).
VITE_MAINTENANCE_END=2026-05-14T12:00:00Z
# Optional SSR/runtime aliases (same meaning as VITE_* above), e.g. Docker without rebuilding:
# MAINTENANCE_MODE=true
# MAINTENANCE_END=2026-05-14T12:00:00Z
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tua-email@gmail.com
SMTP_PASS=tua-app-password
SMTP_FROM="PCReady <noreply@tuodominio.it>"
#secrets.CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
#secrets.CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-with-edit-permissions-for-workers

# Optional: distributed rate limiting across multiple instances (Upstash Redis).
# When unset, the app uses an in-memory sliding window limiter (single Node process).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=